# Konteks build harus kecil: `jobs/` berisi video hasil render (puluhan MB per
# job) dan `assets/own/` sudah ikut git. Tanpa berkas ini setiap build
# mengirim seluruh riwayat render ke daemon.
node_modules
jobs
cache
data
input
netlify-site
.git
.agents
.openhands
*.log
tests
# Model TTS diunduh di dalam image, bukan dikirim sebagai konteks (61 MB).
assets/tts
# Video car-chase hanya untuk pratinjau lokal, tidak dipakai server (23 MB).
assets/car-chase
