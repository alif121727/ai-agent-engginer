# ---- Server ----
PORT=8080
APP_URL=http://localhost:8080
SESSION_SECRET=change-me-to-a-long-random-string
# SQLite (default) or Postgres
DB_KIND=sqlite
DB_PATH=./data/studio.db
# DATABASE_URL=postgres://user:pass@db:5432/studio

# ---- Provider API keys (server only, never sent to browser) ----
# Image generation
IMAGE_PROVIDER_API_KEY=
# Video generation
VIDEO_PROVIDER_API_KEY=
# Stock footage (Pexels / Pixabay)
STOCK_API_KEY=
# LLM untuk penulisan naskah (opsional).
# Isi ketiganya untuk mengaktifkan penulisan narasi oleh LLM.
# Tanpa ketiganya, naskah disusun penyusun lokal dan video tetap dirender.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ---- Instagram (Reels) ----
IG_APP_ID=
IG_APP_SECRET=
IG_ACCESS_TOKEN=

# Seedance 2.0 (API publik seedance2ai.io)
SEEDANCE_API_KEY=
