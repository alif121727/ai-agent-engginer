node_modules/
.env
data/*.db
data/*.db-*
# Job outputs: keep the small text artifacts (script, storyboard, QA report)
# under version control so a lost sandbox loses no creative work, but never
# commit the rendered videos, stills, or clips.
jobs/**
!jobs/*/
!jobs/*/artifacts/
!jobs/*/artifacts/**
cache/
public/app.js
public/app.js.map
public/index.html
docs/ui/*.png
*.log

# Galeri statis: biner besar, jangan masuk git
netlify-site/video/
netlify-site/thumb/
netlify-site.zip
# State deploy lokal (site id sementara dari deploy anonymous)
netlify-site/.netlify/
