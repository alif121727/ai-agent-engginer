node_modules/
.env
data/*.db
data/*.db-*
# Job outputs: keep the small text artifacts (script, storyboard, QA report)
# under version control so a lost sandbox loses no creative work, but never
# commit the rendered videos, stills, or clips.
jobs/**
!jobs/*/
!jobs/*/artifacts/
!jobs/*/artifacts/**
cache/
public/app.js
public/app.js.map
public/index.html
# Artefak build yang disalin dari netlify-site/ oleh scripts/build-studio.ts.
# Sumbernya tetap dilacak; salinan ini dibuat ulang tiap build.
public/sw.js
public/sw-register.js
public/manifest.json
public/robots.txt
public/sitemap.xml
public/404.html
docs/ui/*.png
*.log

# Galeri statis: video & thumb WAJIB ikut git. Situs Netlify terhubung ke
# GitHub dan build-nya jalan dari checkout bersih; kalau file ini diabaikan,
# build menghasilkan galeri tanpa video (dan dulu bahkan 404).
netlify-site.zip
# State deploy lokal (site id sementara dari deploy anonymous)
netlify-site/.netlify/

# Model TTS lokal (63 MB), diunduh lewat scripts/fetch-tts-model.sh
assets/tts/*.onnx
assets/tts/*.onnx.json

# Pratinjau lokal car-chase (video sudah di-commit di assets/car-chase/).
# Dibuat ulang oleh scripts/preview-car-chase.sh; tidak perlu masuk git.
public/media/
