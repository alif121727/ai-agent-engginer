{
  "order": ["local", "video-gen", "image-gen", "image-gen-free", "stock-api"],
  "fallback": {
    "local": ["video-gen", "image-gen", "image-gen-free", "stock-api"],
    "video-gen": ["image-gen", "image-gen-free", "stock-api"],
    "image-gen": ["image-gen-free", "stock-api"],
    "image-gen-free": ["stock-api"],
    "stock-api": []
  },
  "perProvider": {
    "video-gen": { "timeoutMs": 120000, "maxRetries": 2, "cooldownMs": 15000 },
    "image-gen": { "timeoutMs": 60000, "maxRetries": 2, "cooldownMs": 10000 },
    "image-gen-free": { "timeoutMs": 90000, "maxRetries": 4, "cooldownMs": 25000 },
    "stock-api": { "timeoutMs": 20000, "maxRetries": 1, "cooldownMs": 5000 }
  },
  "adapters": {
    "local": {
      "id": "local",
      "label": "Aset milik pengguna",
      "kind": "local",
      "enabled": true,
      "requiresKey": false,
      "description": "Foto/video di assets/own/<slug-model>/ atau kolom referensi template. Prioritas tertinggi karena paling akurat."
    },
    "runway": {
      "id": "runway",
      "label": "Runway (Veo 3.1 / Seedance 2.0 / Gen-4)",
      "kind": "video-gen",
      "provider": "runway",
      "enabled": true,
      "requiresKey": true,
      "envKey": "RUNWAY_API_KEY",
      "model": "veo3.1",
      "timeoutMs": 600000,
      "maxRetries": 1,
      "minBytes": 100000,
      "description": "Satu kunci Runway membuka Veo 3.1, Seedance 2.0, dan Gen-4. Model dipilih dari UI, bukan dari file ini."
    },
    "kling": {
      "id": "kling",
      "label": "Kling 3.0",
      "kind": "video-gen",
      "provider": "kling",
      "enabled": true,
      "requiresKey": true,
      "envKey": "KLING_API_KEY",
      "model": "kling-v3",
      "timeoutMs": 600000,
      "maxRetries": 1,
      "minBytes": 100000,
      "description": "Kling image-to-video dengan kontrol gerakan. Butuh KLING_API_KEY dari platform Kuaishou."
    },
    "video-gen": {
      "id": "video-gen",
      "label": "Generator video (image-to-video)",
      "kind": "video-gen",
      "enabled": true,
      "requiresKey": true,
      "envKey": "VIDEO_PROVIDER_API_KEY",
      "model": "provider-default-i2v",
      "timeoutMs": 120000,
      "maxRetries": 2,
      "minBytes": 500000,
      "description": "Animasikan keyframe fotorealistik jadi klip 3-5 detik. Dipakai kalau kunci tersedia."
    },
    "image-gen": {
      "id": "image-gen",
      "label": "Generator gambar berbayar",
      "kind": "image-gen",
      "enabled": true,
      "requiresKey": true,
      "envKey": "IMAGE_PROVIDER_API_KEY",
      "model": "provider-default-t2i",
      "timeoutMs": 60000,
      "maxRetries": 2,
      "minBytes": 20000,
      "description": "Keyframe fotorealistik per scene. Butuh IMAGE_PROVIDER_URL + IMAGE_PROVIDER_API_KEY."
    },
    "image-gen-free": {
      "id": "image-gen-free",
      "label": "Generator gambar gratis (Pollinations)",
      "kind": "image-gen",
      "enabled": true,
      "requiresKey": false,
      "urlTemplate": "https://image.pollinations.ai/prompt/{prompt}?width={width}&height={height}&nologo=true&model=flux",
      "timeoutMs": 90000,
      "maxRetries": 4,
      "cooldownMs": 25000,
      "minBytes": 20000,
      "description": "Tanpa API key, untuk mode uji. Ada rate limit; hasil bisa lebih lambat dari provider berbayar."
    },
    "stock-api": {
      "id": "stock-api",
      "label": "Stock footage",
      "kind": "stock-api",
      "enabled": true,
      "requiresKey": true,
      "envKey": "STOCK_API_KEY",
      "model": "pexels",
      "creditsFile": "assets/credits.json",
      "description": "Klip stok berlisensi. Atribusi wajib disimpan di assets/credits.json."
    }
  }
}
