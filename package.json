{
  "name": "ai-studio-otomotif",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "api": "node --experimental-strip-types src/api/main.ts",
    "worker": "node --experimental-strip-types src/worker/main.ts",
    "web": "node --experimental-strip-types src/api/main.ts",
    "build:ui": "node --experimental-strip-types scripts/build-ui.ts",
    "test": "node --experimental-strip-types tests/run.ts",
    "llm-check": "node --experimental-strip-types scripts/llm-capability.ts",
    "build:studio": "node --experimental-strip-types scripts/build-studio.ts",
    "typecheck:studio": "tsc --noEmit --jsx react-jsx --module esnext --moduleResolution bundler --target es2020 --skipLibCheck --allowImportingTsExtensions studio/src/main.tsx",
    "export:projects": "node --experimental-strip-types scripts/export-projects.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
